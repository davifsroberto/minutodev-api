// minutoDev — Prisma schema
// Persistência das fontes (Source) e conteúdos coletados (Content) de RSS/API.
// Conexão configurada via variável de ambiente DATABASE_URL (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Tipo da fonte de conteúdo.
enum SourceType {
  RSS
  GITHUB
}

/// Natureza do conteúdo coletado.
enum ContentType {
  ARTICLE
  RELEASE
  TOOL
  DISCUSSION
  REPOSITORY
}

/// Ciclo de vida do conteúdo dentro do radar.
enum ContentStatus {
  NEW
  VISIBLE
  HIDDEN
  ARCHIVED
}

/// Status do enriquecimento de um Content (tradução/resumo). Hoje só PENDING
/// (fallback sem IA); os demais estados preparam o pipeline de IA futuro.
enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Provedor de identidade usado na autenticação. Apenas GOOGLE nesta fase; o
/// enum reserva espaço para futuros provedores sem reabrir o modelo.
enum AuthProvider {
  GOOGLE
}

/// Fonte de conteúdo (feed RSS, repositório GitHub, etc.).
model Source {
  id        String     @id @default(uuid())
  name      String
  type      SourceType
  url       String     @unique
  category  String
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  contents Content[]

  @@map("sources")
}

/// Conteúdo coletado a partir de uma Source.
model Content {
  id          String        @id @default(uuid())
  sourceId    String
  title       String
  url         String        @unique
  summary     String?
  author      String?
  publishedAt DateTime?
  collectedAt DateTime      @default(now())
  category    String?
  tags        String[]
  contentType ContentType
  imageUrl    String?
  rawTitle    String?
  rawSummary  String?
  rawData     Json?
  score       Int           @default(0)
  status      ContentStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  source      Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  enrichments ContentEnrichment[]
  histories   UserContentHistory[]

  @@index([sourceId])
  @@index([status])
  @@index([publishedAt(sort: Desc), collectedAt(sort: Desc)])
  @@map("contents")
}

/// Camada de entendimento/curadoria sobre um Content (tradução, resumo,
/// pontos-chave). Nesta fase é preenchida com fallback do próprio Content;
/// os campos provider/model/status preparam o enriquecimento por IA futuro.
model ContentEnrichment {
  id              String           @id @default(uuid())
  contentId       String
  language        String           @default("pt-BR")
  translatedTitle String?
  summary30s      String?
  shortSummary    String?
  whyItMatters    String?
  keyInsight      String?
  keyPoints       String[]
  example         String?
  whenToUse       String?
  audienceFor     String[]
  audienceIgnore  String[]
  briefContent    String?
  originalUrl     String
  provider        String?
  model           String?
  status          EnrichmentStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, language])
  @@map("content_enrichments")
}

/// Usuário autenticado da plataforma. Base para a personalização da V2
/// (interesses, favoritos, histórico). Identidade externa fica em
/// (provider, providerId); `email` é único para uma conta por e-mail.
model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String
  avatarUrl  String?
  provider   AuthProvider
  providerId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  interests UserInterest[]
  histories UserContentHistory[]

  @@unique([provider, providerId])
  @@map("users")
}

/// Catálogo canônico de temas editoriais. Fonte ÚNICA da taxonomia de
/// interesses: o `slug` segue o vocabulário do projeto (parte já presente em
/// `Source.category`, o restante é a taxonomia-alvo). Seedável de forma
/// idempotente (slug é único), igual às Sources; `enabled` permite aposentar um
/// tema sem apagar histórico.
model Topic {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userInterests UserInterest[]

  @@map("topics")
}

/// Histórico de leitura: registro único por (usuário, conteúdo). Abrir de novo
/// atualiza `lastOpenedAt`/`openCount`; `readAt` marca leitura concluída e é
/// preservado em chamadas repetidas. Não é analytics — é funcionalidade do
/// usuário (página de histórico, base para o radar personalizado da V2).
model UserContentHistory {
  id            String    @id @default(uuid())
  userId        String
  contentId     String
  firstOpenedAt DateTime  @default(now())
  lastOpenedAt  DateTime  @default(now())
  readAt        DateTime?
  openCount     Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  // Serve o GET /me/history (filtra por userId e ordena por último acesso).
  @@index([userId, lastOpenedAt(sort: Desc)])
  @@map("user_content_history")
}

/// Junção N:N entre User e Topic — interesses (opcionais) do usuário.
/// `(userId, topicId)` único garante a idempotência do PUT /me/interests.
model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // O índice único composto já serve as buscas por `userId` (prefixo à
  // esquerda), então não há um @@index([userId]) separado e redundante.
  @@unique([userId, topicId])
  @@map("user_interests")
}
