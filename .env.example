# Ambiente da aplicação
NODE_ENV=development

# Porta HTTP do servidor NestJS
PORT=3500

# --- CORS ---
# Allowlist de origins autorizados a consumir a API a partir do browser,
# separada por vírgulas. GET-only, sem credenciais. Vazia/ausente = nenhum
# acesso cross-origin (o front cai no estado de erro), nunca derruba o boot.
# Em produção, adicione aqui o host do front quando definido.
CORS_ORIGINS=http://localhost:4500

# --- Banco de dados (PostgreSQL) ---
# Partes usadas para compor a DATABASE_URL. Ajuste conforme o seu Postgres
# local (rodando via Docker). A composição abaixo usa expansão de variáveis
# (${...}), suportada pelo dotenv-expand e pelo Prisma.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=minutodev

# Connection string consumida pelo Prisma (migrations, seed, client).
DATABASE_URL=postgresql://${DATABASE_USERNAME}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# Alternativa: você pode definir a DATABASE_URL diretamente, sem as partes
# acima. Exemplo (não é definitivo, apenas ilustrativo):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minutodev?schema=public"

# --- Inteligência Artificial (IA / LLM) ---
# Provedor usado para enriquecer conteúdo (tradução/resumo em pt-BR).
# Valores aceitos: mock | deepseek | gemini | openrouter | ollama.
# Padrão: mock — sem custo, sem chave e sem API externa.
# A geração é sempre sob demanda; nada é processado automaticamente.
LLM_PROVIDER=mock

# Configuração genérica de LLM. LLM_MODEL é opcional e usa o padrão do provedor
# ativo quando vazio (ex.: deepseek-chat para deepseek). LLM_TIMEOUT_MS é
# opcional; padrão 30000.
LLM_MODEL=
LLM_TIMEOUT_MS=30000

# DeepSeek — implementado; usado apenas quando LLM_PROVIDER=deepseek. A chave
# NUNCA deve ser commitada. Sem chave, o provedor falha com mensagem clara
# quando chamado; o restante do projeto continua rodando normalmente.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (Google) — implementado; usado quando LLM_PROVIDER=gemini. A chave NUNCA
# deve ser commitada. O modelo é controlado por LLM_MODEL (padrão: gemini-2.5-flash
# quando vazio). GEMINI_BASE_URL é opcional (padrão: a API pública do Google,
# https://generativelanguage.googleapis.com/v1beta).
GEMINI_API_KEY=
GEMINI_BASE_URL=

# Placeholders de providers reconhecidos, ainda não implementados. Selecionar
# openrouter ou ollama permite o boot, mas chamadas de IA falham até a
# implementação real existir.
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=

# --- Imagem de capa (og:image) ---
# Quando o RSS não traz imagem, a página do artigo é buscada para extrair o
# og:image/twitter:image (sob demanda, com anti-SSRF/timeout/cache). Defina como
# false para desligar a busca de rede (a capa branded por fonte continua).
# Padrão: ligado.
OG_IMAGE_ENABLED=true
